<% layout('/layouts/boilerplate') %>

    <body>
        <div class="row">

            <div class="col-8 offset-2">

                <h3 class="mt-3">Edit your listing</h3>
                <form method="post" action="/listings/<%= listing._id %>?_method=PATCH" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label for="title" class="form-lable">Title</label>
                        <input type="text" name="listing[title]" class="form-control" required placeholder="Write title here..."
                            value="<%= listing.title %>">
                        <div class="invalid-feedback">Title needs to be filled</div>

                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-lable">Description</label>
                        <textarea name="listing[description]" id="dec" class="form-control" required
                            placeholder="write description..."><%= listing.description %>"</textarea>
                        <div class="invalid-feedback">Please add a short description</div>

                    </div>

                    <div class="mb-3">
                        <label for="image" class="form-lable">Image Link</label>
                        <input type="text" name="listing[image]" class="form-control"
                            placeholder=" Enter image url/link" value="<%= listing.image %>">
                    </div>

                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label for="price" class="form-lable">Price</label>
                            <input type="number" name="listing[price]" required class="form-control" id=""
                                placeholder="Enter price..." value="<%= listing.price %>">
                            <div class="invalid-feedback">Enter a price value</div>
                        </div>

                        <div class="mb-3 col-md-8">
                            <label for="country" class="form-lable">Country</label>
                            <input type="text" name="listing[country]" class="form-control" placeholder="Enter country" required value="<%= listing.country %>">
                            <div class="invalid-feedback">Country is required</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="location" class="form-lable">Location</label>
                        <input type="location" name="listing[location]" class="form-control"
                            placeholder="Enter location" required value="<%= listing.location %>">
                        <div class="invalid-feedback">Location is must to enter</div>
                    </div>
                    <br>
                    <button class="btn edit-btn">Edit</button>
                    <br><br>
                </form>
            </div>
        </div>
            <script src="/js/script.js"></script>
    </body>