<% layout('/layouts/boilerplate') %>

  <body>
    <h3 class="mt-3">Create a new Listing</h3>
    <div class="row">
      <div class="col-8 offset-2">
        <form method="post" action="/listings" novalidate class="needs-validation">
          <div class="mb-3">
            <label for="title" class="form-lable">Title</label>
            <input type="text" name="listing[title]" placeholder="Write title here..." required class="form-control">
            <div class="valid-feedback">Title looks good</div>
            <div class="invalid-feedback">Title needs to be filled</div>

          </div>

          <div class="mb-3">
            <label for="description" class="form-lable">Description</label>
            <textarea name="listing[description]" id="dec" class="form-control" required
              placeholder="Write description here..." required></textarea>
            <div class="invalid-feedback">Please add a short description</div>
          </div>

          <div class="mb-3">
            <label for="image" class="form-lable">Image Link</label>
            <input type="text" name="listing[image]" class="form-control" placeholder="Enter Image link/url">
          </div>

          <div class="row">
            <div class="mb-3 col-md-4">
              <label for="price" class="form-lable">Price</label>
              <input type="number" name="listing[price]" id="" class="form-control" required placeholder="1249">
              <div class="invalid-feedback">Enter a price value</div>
            </div>

            <div class="mb-3 col-md-8">
              <label for="country" class="form-lable">Country</label>
              <input type="text" name="listing[country]" class="form-control" required placeholder="India">
              <div class="invalid-feedback">Country is required</div>
            </div>
          </div>

          <div class="mb-3 ">
            <label for="location" class="form-lable">Location</label>
            <input type="location" name="listing[location]" class="form-control" required
              placeholder="Meerut,UtterPradesh">
            <div class="invalid-feedback">Location is must to enter</div>
          </div>
          <br>
          <button class="btn add-btn">Create</button>
        </form>
        <br><br>
      </div>
    </div>
  </body>