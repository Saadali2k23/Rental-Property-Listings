<% layout('/layouts/boilerplate') %>

    <body>
        <div class="row">
            <div class="col-8 offset-3">
                <h3 class="mt-3">
                    <%= listing.title %>
                </h3>
            </div>
            <div class="card col-6 offset-3 show-card listing-card">
                <img src="<%= listing.image %>" alt="listing_image show-image" class="card-img-top">
                <div class="card-body">
                    <p class="card-text mt-2"><b> </b>
                        <br>
                        <%= listing.description %>
                            <br>
                            &#8377 <%= listing.price.toLocaleString("en-IN") %>
                                <br>
                                <%= listing.country %>
                                    <br>
                                    <%= listing.location%>
                    </p>
                </div>

            </div>

            <div class="btns">
                <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn mb-4 col-1 offset-3 btn-dark">Edit</a>

                <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn delete-btn mb-4 offset-5 btn-dark">Delete</button>
                </form>
            </div>
            <div class="col-8 offset-3 mb-3">
            <hr>
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                </div>

                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label"></label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="8" class="form-control" required ></textarea>
                    <div class="invalid-feedback">Please write some comments first </div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
            <hr>
            <h4> All Reviews</h4>
            <div class="row">
             <% for(review of listing.reviews){ %>
               <div class="card col-5 ms-3 mb-3">
                <div class="card-body"></div>
                <h5 class="card-title"> /listings/<%= listing._id %>/reviews/<%= review._id %></h5>
                <p class="card-text"> <%= review.comment %></p>
                <p class="card-text">Rating : <%= review.rating %></p>
                <form  method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button type="submit" class="btn ">Delete</button>
                </form>
               </div>
             <% } %>
         </div>
        </div>
        </div>
    </body>